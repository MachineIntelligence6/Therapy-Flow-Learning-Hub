# TherapyFlow Learning Hub — environment variables
# Copy to .env and fill in values:
#   cp .env.example .env

# ── Backend CMS origin (no trailing slash) ───────────────────────────────────
# Used by src/services/strapi.ts and scripts/prerender-hub.mjs
#
# Local backend:    http://localhost:8080
# Production:       https://api.therapyflow.pro
VITE_CMS_API_URL=http://localhost:8080

# Enable CMS in local dev (disables mock articles)
VITE_CMS_ENABLED=true

# Legacy aliases (optional fallbacks)
# VITE_STRAPI_API_URL=
# VITE_STRAPI_ENABLED=
# VITE_STRAPI_API_TOKEN=
