# TherapyFlow Learning Hub — environment variables
# Copy to .env and fill in values:
#   cp .env.example .env

# ── Strapi origin (no trailing slash) ────────────────────────────────────────
# Used by src/services/strapi.ts and scripts/prerender-hub.mjs
#
# Local Strapi:     http://localhost:1337
# Production:       https://strapi-admin.therapyflow.pro
# Strapi Cloud dev: https://your-project.strapiapp.com
VITE_STRAPI_API_URL=http://localhost:1337

# ── Enable Strapi in dev (set to true to disable mock articles) ─────────────
# In production builds, Strapi is always used when VITE_STRAPI_API_URL is set.
VITE_STRAPI_ENABLED=true

# ── API token (recommended — same token as landing page) ───────────────────
# Create in Strapi Admin → Settings → API Tokens → Full access (read)
VITE_STRAPI_API_TOKEN=
