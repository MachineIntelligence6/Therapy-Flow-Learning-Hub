{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.css", "/*.js", "/*.svg", "/*.png", "/*.webp", "/*.xml", "/*.txt", "/*/index.html"]
  },
  "routes": [
    { "route": "/learning-hub", "redirect": "/", "statusCode": 301 },
    { "route": "/learning-hub/*", "redirect": "/{slug}", "statusCode": 301 }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  }
}
